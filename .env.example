# ============================================================
# Tekyrios AI Support — Variables de entorno
# Copia este archivo a .env y completa los valores
# ============================================================

# ---- Floci (AWS Local Emulator) ----
# Floci corre en localhost:4566. Creds dummy, cualquier valor funciona.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
FLOCI_STORAGE_MODE=hybrid

# ---- LLM Provider ----
# Usa OpenAI o cualquier compatible. Para local: Ollama/LM Studio.
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- LangFuse (Observabilidad) ----
# Obtén keys en https://cloud.langfuse.com (gratis) o self-host.
LANGFUSE_PUBLIC_KEY=pk-xxxx
LANGFUSE_SECRET_KEY=sk-xxxx
LANGFUSE_HOST=https://cloud.langfuse.com
# Para self-host en Docker descomenta:
# LANGFUSE_HOST=http://localhost:3000

# ---- LangSmith (Evaluación) ----
# Obtén API key en https://smith.langchain.com (tier gratuito)
LANGSMITH_API_KEY=lsv2_xxxx
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=tekyrios-ai-support

# ---- Recursos en Floci ----
S3_KB_BUCKET=tekyrios-kb
DYNAMODB_TABLE=tekyrios-conversations
SQS_ESCALATION_QUEUE=tekyrios-escalations
LAMBDA_FUNCTION_NAME=tekyrios-support
API_GATEWAY_NAME=tekyrios-support-api
